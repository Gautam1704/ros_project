<?xml version="1.0" ?>
<robot name="slam_lidar_midplate_mid_with_imu" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find ros_project)/urdf/materials.xacro" />
<xacro:include filename="$(find ros_project)/urdf/slam_lidar_midplate_mid_with_imu.ros2control" />
<xacro:include filename="$(find ros_project)/urdf/slam_lidar_midplate_mid_with_imu.gazebo" />

<gazebo>
  <plugin
    filename="libgz-sim-diff-drive-system.so"
    name="gz::sim::systems::DiffDrive">

    <left_joint>Revolute_1</left_joint>
    <right_joint>Revolute_2</right_joint>

    <wheel_separation>0.23</wheel_separation>
    <wheel_radius>0.081</wheel_radius>

    <odom_topic>odom</odom_topic>
    <tf_topic>/tf</tf_topic>

    <frame_id>odom</frame_id>
    <child_frame_id>base_footprint</child_frame_id>

    <topic>cmd_vel</topic>

    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
  </plugin>
  <plugin
    filename="libgz-sim-joint-state-publisher-system.so"
    name="gz::sim::systems::JointStatePublisher">

    <topic>/joint_states</topic>

  </plugin>
</gazebo>

<link name="base_link">
  <inertial>
    <origin xyz="-0.0019297244191736867 0.0018747496550703066 0.06995619724607677" rpy="0 0 0"/>
    <mass value="21.04115508065235"/>
    <inertia ixx="0.188108" iyy="0.289502" izz="0.293599" ixy="-0.000208" iyz="-0.000266" ixz="-7.4e-05"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ros_project)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ros_project)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>
<joint name="base_footprint_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

<link name="base_footprint">
</link>



<link name="wheel_urdf_1">
  <inertial>
    <origin xyz="-4.001574910018034e-07 -0.05000001627830493 -4.836244008737944e-07" rpy="0 0 0"/>
    <mass value="7.44298937241317"/>
    <inertia ixx="0.013521" iyy="0.024417" izz="0.013521" ixy="-0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.001839 0.112411 -0.034922" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ros_project)/meshes/wheel_urdf_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.001839 0.112411 -0.034922" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ros_project)/meshes/wheel_urdf_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="wheel_urdf__1__1">
  <inertial>
    <origin xyz="-4.0015749095214694e-07 0.04999998372169512 -4.836244007905277e-07" rpy="0 0 0"/>
    <mass value="7.44298937241317"/>
    <inertia ixx="0.013521" iyy="0.024417" izz="0.013521" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.001839 -0.117589 -0.034922" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ros_project)/meshes/wheel_urdf__1__1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.001839 -0.117589 -0.034922" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ros_project)/meshes/wheel_urdf__1__1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="ball_caster_wheel__1__1">
  <inertial>
    <origin xyz="-4.001574910317274e-07 -1.6278612177851592e-08 -0.012099534835058778" rpy="0 0 0"/>
    <mass value="0.1479113408447469"/>
    <inertia ixx="2.2e-05" iyy="2e-05" izz="2.4e-05" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.166839 -0.002589 0.016578" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ros_project)/meshes/ball_caster_wheel__1__1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.166839 -0.002589 0.016578" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ros_project)/meshes/ball_caster_wheel__1__1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="ball_caster_wheel_1">
  <inertial>
    <origin xyz="-4.001574910039718e-07 -1.627861223596483e-08 -0.012099534835058767" rpy="0 0 0"/>
    <mass value="0.1479113408447469"/>
    <inertia ixx="2.2e-05" iyy="2e-05" izz="2.4e-05" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.163161 -0.002589 0.016578" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ros_project)/meshes/ball_caster_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.163161 -0.002589 0.016578" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ros_project)/meshes/ball_caster_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="imu_for_urdf_1">
  <inertial>
    <origin xyz="-2.395242713676784e-05 -4.697533164545013e-05 0.0011097424638633197" rpy="0 0 0"/>
    <mass value="0.007271179941885703"/>
    <inertia ixx="0.0" iyy="0.0" izz="1e-06" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.001839 -0.002589 -0.104922" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ros_project)/meshes/imu_for_urdf_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.001839 -0.002589 -0.104922" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ros_project)/meshes/imu_for_urdf_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="lidar_urdf_1">
  <inertial>
    <origin xyz="-4.0015749110241736e-07 -1.6278304991717424e-08 0.04331001637559857" rpy="0 0 0"/>
    <mass value="0.5565046796809807"/>
    <inertia ixx="0.000186" iyy="0.000186" izz="0.000341" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.001839 -0.002589 -0.104922" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ros_project)/meshes/lidar_urdf_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.001839 -0.002589 -0.104922" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ros_project)/meshes/lidar_urdf_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="Revolute_1" type="continuous">
  <origin xyz="-0.001839 -0.112411 0.034922" rpy="0 0 0"/>
  <parent link="base_footprint"/>
  <child link="wheel_urdf_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Revolute_2" type="continuous">
  <origin xyz="-0.001839 0.117589 0.034922" rpy="0 0 0"/>
  <parent link="base_footprint"/>
  <child link="wheel_urdf__1__1"/>
  <axis xyz="0.0 -1.0 -0.0"/>
</joint>

<joint name="Rigid 3" type="fixed">
  <origin xyz="-0.166839 0.002589 -0.016578" rpy="0 0 0"/>
  <parent link="base_footprint"/>
  <child link="ball_caster_wheel__1__1"/>
</joint>

<joint name="Rigid 4" type="fixed">
  <origin xyz="0.163161 0.002589 -0.016578" rpy="0 0 0"/>
  <parent link="base_footprint"/>
  <child link="ball_caster_wheel_1"/>
</joint>

<joint name="Rigid 5" type="fixed">
  <origin xyz="-0.001839 0.002589 0.104922" rpy="0 0 0"/>
  <parent link="base_footprint"/>
  <child link="imu_for_urdf_1"/>
</joint>

<joint name="Rigid 6" type="fixed">
  <origin xyz="-0.001839 0.002589 0.104922" rpy="0 0 0"/>
  <parent link="base_footprint"/>
  <child link="lidar_urdf_1"/>
</joint>

<gazebo>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>
</gazebo>

<!-- 1. Global block — add Imu system alongside Sensors -->
<gazebo>
  <plugin filename="libgz-sim-sensors-system.so" name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>
  <!-- 👇 Add this line -->
  <plugin filename="libgz-sim-imu-system.so" name="gz::sim::systems::Imu"/>
</gazebo>

<!-- 2. IMU sensor on your link — NO plugin block inside -->
<gazebo reference="imu_for_urdf_1">
  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <visualize>true</visualize>
    <topic>/imu/data</topic>
    <gz_frame_id>imu_for_urdf_1</gz_frame_id>
    <imu>
      <angular_velocity>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>2e-4</stddev>
            <bias_mean>0.0000075</bias_mean>
            <bias_stddev>0.0000008</bias_stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>2e-4</stddev>
            <bias_mean>0.0000075</bias_mean>
            <bias_stddev>0.0000008</bias_stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>2e-4</stddev>
            <bias_mean>0.0000075</bias_mean>
            <bias_stddev>0.0000008</bias_stddev>
          </noise>
        </z>
      </angular_velocity>
      <linear_acceleration>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>1.7e-2</stddev>
            <bias_mean>0.1</bias_mean>
            <bias_stddev>0.001</bias_stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>1.7e-2</stddev>
            <bias_mean>0.1</bias_mean>
            <bias_stddev>0.001</bias_stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>1.7e-2</stddev>
            <bias_mean>0.1</bias_mean>
            <bias_stddev>0.001</bias_stddev>
          </noise>
        </z>
      </linear_acceleration>
    </imu>
  </sensor>
</gazebo>

</robot>
